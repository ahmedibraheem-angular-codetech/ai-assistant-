APP_NAME=Personal AI Assistant
APP_ENV=development
API_PREFIX=/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MODEL=
# Recent messages sent to Ollama. The full transcript stays in SQLite.
# CHAT_CONTEXT_MESSAGE_LIMIT=20
# Enabled memories injected into one request. Unrelated memories stay stored.
# MEMORY_INJECTION_LIMIT=5
# Seconds before an unconfirmed remember or forget proposal expires.
# MEMORY_ACTION_TTL_SECONDS=900
# APPROVAL_TTL_SECONDS=900
# Automatic agent selection when a chat request does not name an agent.
# AUTO_AGENT_ROUTING_ENABLED=true
# Empty uses OLLAMA_MODEL for the routing call.
# AGENT_ROUTING_MODEL=
# AGENT_ROUTING_CONFIDENCE_THRESHOLD=0.6
# AGENT_ROUTING_TIMEOUT_SECONDS=30
# Tool execution stays inside the backend. Empty grants mean no tools are offered.
# TOOL_EXECUTION_ENABLED=true
# TOOL_MAX_CALLS_PER_TURN=3
# TOOL_DEFAULT_TIMEOUT_SECONDS=10
# Comma-separated tools for the default assistant. Example: calculator,datetime
# DEFAULT_ASSISTANT_TOOLS=
# Timezone used by the datetime tool.
# DEFAULT_TIMEZONE=UTC
# Web search is external network access, not local inference. It is off by default.
# The built-in provider is DuckDuckGo's instant-answer API and needs no key.
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_MAX_RESULTS=5
# The API has no authentication. Keep it on localhost. Do not use 0.0.0.0.
# API_HOST=127.0.0.1
# Read-only file tools. Workspaces are registered explicitly and are never created automatically.
# FILE_MAX_BYTES=1048576
# FILE_MAX_OUTPUT_CHARS=20000
# FILE_LIST_LIMIT=200
# FILE_SEARCH_LIMIT=20
# FILE_MAX_MEMORY_BYTES=33554432
# FILE_MAX_CONCURRENT_WORKERS=4
# FILE_ZIP_MAX_UNCOMPRESSED_BYTES=33554432
# FILE_ZIP_MAX_FILES=128
# FILE_ZIP_MAX_RATIO=100
# Optional SQLAlchemy URL. When unset, the app uses <project>/data/assistant.db.
# A PostgreSQL URL can replace SQLite later without changing the agent repository.
# DATABASE_URL=sqlite:///./data/assistant.db
# Concurrent MCP server processes (1-16).
# MCP_MAX_PROCESSES=2
# Default daily limits per agent (empty = unlimited). Per-agent budgets override.
# AGENT_DAILY_TOOL_CALLS=
# AGENT_DAILY_CHAT_TURNS=
# Code sandbox (run_code). Needs Docker. Every run asks for approval.
# SANDBOX_ENABLED=false
# SANDBOX_TIMEOUT_SECONDS=20
# SANDBOX_MEMORY_MB=512
